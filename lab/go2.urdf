<?xml version="1.0"?>
<!--
  Unitree Go2 — minimal URDF for rviz2 visualization.
  Geometry matches the SDF model (box trunk, cylinder legs, sphere feet).
  Joint names match the unitree_gz_translator JointState publisher.
-->
<robot name="go2">

  <material name="gray"><color rgba="0.75 0.75 0.75 1"/></material>
  <material name="orange"><color rgba="0.8 0.4 0.0 1"/></material>
  <material name="darkgray"><color rgba="0.55 0.55 0.55 1"/></material>
  <material name="white"><color rgba="0.9 0.9 0.9 1"/></material>

  <!-- ── Trunk ── -->
  <link name="base_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="0.60 0.28 0.12"/></geometry>
      <material name="gray"/>
    </visual>
    <inertial>
      <mass value="8.0"/>
      <inertia ixx="0.059" ixy="0" ixz="0" iyy="0.247" iyz="0" izz="0.292"/>
    </inertial>
  </link>

  <!-- ════════════════════════════════════
       FR (front-right) leg
  ════════════════════════════════════ -->
  <joint name="FR_hip_joint" type="revolute">
    <parent link="base_link"/><child link="FR_hip"/>
    <origin xyz="0.183 -0.047 0" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="-0.80" upper="0.80" effort="23.7" velocity="30.1"/>
  </joint>
  <link name="FR_hip">
    <visual>
      <origin xyz="0 -0.025 0" rpy="0 0 0"/>
      <geometry><box size="0.040 0.050 0.040"/></geometry>
      <material name="orange"/>
    </visual>
    <inertial><mass value="0.5"/>
      <inertia ixx="0.0002" ixy="0" ixz="0" iyy="0.0005" iyz="0" izz="0.0005"/>
    </inertial>
  </link>

  <joint name="FR_thigh_joint" type="revolute">
    <parent link="FR_hip"/><child link="FR_thigh"/>
    <origin xyz="0 -0.05 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.57" upper="3.14" effort="23.7" velocity="30.1"/>
  </joint>
  <link name="FR_thigh">
    <visual>
      <origin xyz="0 0 -0.1" rpy="0 0 0"/>
      <geometry><cylinder radius="0.022" length="0.156"/></geometry>
      <material name="darkgray"/>
    </visual>
    <inertial><mass value="1.0"/>
      <inertia ixx="0.0028" ixy="0" ixz="0" iyy="0.0028" iyz="0" izz="0.00025"/>
    </inertial>
  </link>

  <joint name="FR_calf_joint" type="revolute">
    <parent link="FR_thigh"/><child link="FR_calf"/>
    <origin xyz="0 0 -0.2" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-2.77" upper="-0.66" effort="35.55" velocity="20.06"/>
  </joint>
  <link name="FR_calf">
    <visual>
      <origin xyz="0 0 -0.1" rpy="0 0 0"/>
      <geometry><cylinder radius="0.013" length="0.156"/></geometry>
      <material name="darkgray"/>
    </visual>
    <inertial><mass value="0.3"/>
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.00003"/>
    </inertial>
  </link>

  <joint name="FR_foot_joint" type="fixed">
    <parent link="FR_calf"/><child link="FR_foot"/>
    <origin xyz="0 0 -0.2" rpy="0 0 0"/>
  </joint>
  <link name="FR_foot">
    <visual>
      <origin xyz="0 0 -0.025" rpy="0 0 0"/>
      <geometry><sphere radius="0.025"/></geometry>
      <material name="white"/>
    </visual>
    <inertial><mass value="0.06"/>
      <inertia ixx="0.000006" ixy="0" ixz="0" iyy="0.000006" iyz="0" izz="0.000006"/>
    </inertial>
  </link>

  <!-- ════════════════════════════════════
       FL (front-left) leg
  ════════════════════════════════════ -->
  <joint name="FL_hip_joint" type="revolute">
    <parent link="base_link"/><child link="FL_hip"/>
    <origin xyz="0.183 0.047 0" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="-0.80" upper="0.80" effort="23.7" velocity="30.1"/>
  </joint>
  <link name="FL_hip">
    <visual>
      <origin xyz="0 0.025 0" rpy="0 0 0"/>
      <geometry><box size="0.040 0.050 0.040"/></geometry>
      <material name="orange"/>
    </visual>
    <inertial><mass value="0.5"/>
      <inertia ixx="0.0002" ixy="0" ixz="0" iyy="0.0005" iyz="0" izz="0.0005"/>
    </inertial>
  </link>

  <joint name="FL_thigh_joint" type="revolute">
    <parent link="FL_hip"/><child link="FL_thigh"/>
    <origin xyz="0 0.05 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.57" upper="3.14" effort="23.7" velocity="30.1"/>
  </joint>
  <link name="FL_thigh">
    <visual>
      <origin xyz="0 0 -0.1" rpy="0 0 0"/>
      <geometry><cylinder radius="0.022" length="0.156"/></geometry>
      <material name="darkgray"/>
    </visual>
    <inertial><mass value="1.0"/>
      <inertia ixx="0.0028" ixy="0" ixz="0" iyy="0.0028" iyz="0" izz="0.00025"/>
    </inertial>
  </link>

  <joint name="FL_calf_joint" type="revolute">
    <parent link="FL_thigh"/><child link="FL_calf"/>
    <origin xyz="0 0 -0.2" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-2.77" upper="-0.66" effort="35.55" velocity="20.06"/>
  </joint>
  <link name="FL_calf">
    <visual>
      <origin xyz="0 0 -0.1" rpy="0 0 0"/>
      <geometry><cylinder radius="0.013" length="0.156"/></geometry>
      <material name="darkgray"/>
    </visual>
    <inertial><mass value="0.3"/>
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.00003"/>
    </inertial>
  </link>

  <joint name="FL_foot_joint" type="fixed">
    <parent link="FL_calf"/><child link="FL_foot"/>
    <origin xyz="0 0 -0.2" rpy="0 0 0"/>
  </joint>
  <link name="FL_foot">
    <visual>
      <origin xyz="0 0 -0.025" rpy="0 0 0"/>
      <geometry><sphere radius="0.025"/></geometry>
      <material name="white"/>
    </visual>
    <inertial><mass value="0.06"/>
      <inertia ixx="0.000006" ixy="0" ixz="0" iyy="0.000006" iyz="0" izz="0.000006"/>
    </inertial>
  </link>

  <!-- ════════════════════════════════════
       RR (rear-right) leg
  ════════════════════════════════════ -->
  <joint name="RR_hip_joint" type="revolute">
    <parent link="base_link"/><child link="RR_hip"/>
    <origin xyz="-0.183 -0.047 0" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="-0.80" upper="0.80" effort="23.7" velocity="30.1"/>
  </joint>
  <link name="RR_hip">
    <visual>
