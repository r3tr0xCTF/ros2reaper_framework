  <!-- ═══════════════════════════════════════════════
       PLUGINS
  ═══════════════════════════════════════════════ -->

  <!-- Publish joint states to gz transport: /go2/joint_states -->
  <plugin filename="gz-sim-joint-state-publisher-system"
          name="gz::sim::systems::JointStatePub">
    <topic>/go2/joint_states</topic>
    <update_rate>100</update_rate>
  </plugin>

  <!-- Body velocity control: /go2/cmd_vel (Twist) → applied to trunk -->
  <plugin filename="gz-sim-velocity-control-system"
          name="gz::sim::systems::VelocityControl">
    <topic>/go2/cmd_vel</topic>
  </plugin>

  <!-- ── 12 Joint Controllers (velocity mode) ── -->
  <!-- Each topic receives a gz.msgs.Double (rad/s velocity target) -->

  <plugin filename="gz-sim-joint-controller-system"
          name="gz::sim::systems::JointController">
    <joint_name>FR_hip_joint</joint_name>
    <topic>/go2/joint_vel/FR_hip</topic>
  </plugin>
  <plugin filename="gz-sim-joint-controller-system"
          name="gz::sim::systems::JointController">
    <joint_name>FR_thigh_joint</joint_name>
    <topic>/go2/joint_vel/FR_thigh</topic>
  </plugin>
  <plugin filename="gz-sim-joint-controller-system"
          name="gz::sim::systems::JointController">
    <joint_name>FR_calf_joint</joint_name>
    <topic>/go2/joint_vel/FR_calf</topic>
  </plugin>

  <plugin filename="gz-sim-joint-controller-system"
          name="gz::sim::systems::JointController">
    <joint_name>FL_hip_joint</joint_name>
    <topic>/go2/joint_vel/FL_hip</topic>
  </plugin>
  <plugin filename="gz-sim-joint-controller-system"
          name="gz::sim::systems::JointController">
    <joint_name>FL_thigh_joint</joint_name>
    <topic>/go2/joint_vel/FL_thigh</topic>
  </plugin>
  <plugin filename="gz-sim-joint-controller-system"
